{
    "manifest_version": 3,
    "name": "browse",
    "version": "1.0.0",
    "background": {
        "service_worker": "worker.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["stub.js"],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["*"],
            "matches": ["<all_urls>"]
        }
    ],
    "commands": {
        "focus_left": {
            "suggested_key": { "mac": "MacCtrl+Left" },
            "description": "Focus left tab"
        },
        "focus_right": {
            "suggested_key": { "mac": "MacCtrl+Right" },
            "description": "Focus right tab"
        },
        "move_left": {
            "suggested_key": { "mac": "MacCtrl+Shift+Left" },
            "description": "Move tab left"
        },
        "move_right": {
            "suggested_key": { "mac": "MacCtrl+Shift+Right" },
            "description": "Move tab right"
        },
        "new_tab": {
            "description": "New Tab"
        },
        "close_tab": {
            "description": "Close Tab"
        }
    }
}