{
    "manifest_version": 3,
    "name": "browse",
    "version": "1.0.0",
    "background": {
        "service_worker": "worker.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["stub.js"],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["*"],
            "matches": ["<all_urls>"]
        }
    ]
}
